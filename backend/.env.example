# Copy to .env (never commit real values). Spring reads these as environment variables.
DATABASE_URL=jdbc:postgresql://localhost:5432/foodwise
DATABASE_USERNAME=foodwise
DATABASE_PASSWORD=foodwise
FRONTEND_URL=http://localhost:3000

# AUTH_MODE=DEV (local only, default in the dev profile) or CLERK (required in prod)
AUTH_MODE=DEV
DEV_JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes-long!!

# Clerk (when AUTH_MODE=CLERK)
CLERK_JWKS_URI=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SECRET=whsec_xxx
CLERK_SECRET_KEY=

# OCR: folder that contains eng.traineddata (auto-detected on common Linux/macOS/Windows install paths)
TESSDATA_PATH=
# Experimental haul recognition (leave empty until an approved model exists)
HAUL_MODEL_PATH=
HAUL_LABELS_PATH=
