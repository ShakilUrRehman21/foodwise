# Leave NEXT_PUBLIC_API_URL empty: the app proxies /api/* to API_PROXY_TARGET (same origin, no CORS).
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:8080
# Leave Clerk keys empty for local development (uses the backend's dev sign-in).
# Set both to enable Clerk authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
